{
  "name": "thejaz-planner",
  "version": "0.2.133",
  "author": {
    "name": "THEJAZ",
    "url": "https://github.com/thejaz/"
  },
  "homepage": "https://github.com/thejaz/",
  "private": true,
  "description": "A keyboard-friendly Obsidian planner whose source of truth is ordinary Markdown.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "setup:lint": "npm ci --prefix tools/lint --ignore-scripts",
    "lint": "node tools/lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "package": "node tools/package.mjs",
    "release": "node tools/release.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "obsidian": "1.14.4",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
